{
	"name": "wbuilder",
	"version": "0.1.0",
	"description": "Obsidian plugin: Markdown notes linked to an interactive procedural tile map.",
	"main": "main.js",
	"private": true,
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc --noEmit && node esbuild.config.mjs production",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"deps": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/deps.ps1"
	},
	"license": "MIT",
	"devDependencies": {
		"esbuild": "^0.28.2",
		"obsidian": "^1.14.4",
		"typescript": "^7.0.2",
		"vitest": "^5.0.5"
	},
	"dependencies": {
		"simplex-noise": "^4.0.3",
		"zod": "^4.6.7"
	}
}
